<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText 
        android:id="@+id/etDeviceName" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:hint="اسم الجهاز"/>

    <EditText 
        android:id="@+id/etDeviceType" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:hint="نوع الجهاز" 
        android:layout_marginTop="10dp"/>

    <EditText 
        android:id="@+id/etFaultsHistory" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:hint="الأعطال السابقة والحلول..." 
        android:lines="4" 
        android:layout_marginTop="10dp"/>

    <Button 
        android:id="@+id/btnSelectPdf" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="📎 اختر ملف المانيوال (PDF)" 
        android:layout_marginTop="20dp" 
        android:backgroundTint="#FF9800"/>

    <TextView 
        android:id="@+id/tvSelectedPdfPath" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="لم يتم اختيار ملف" 
        android:textColor="#757575" 
        android:layout_marginTop="10dp"/>

    <Button 
        android:id="@+id/btnSaveDevice" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="حفظ وتوليد كود QR" 
        android:layout_marginTop="30dp" 
        android:backgroundTint="#2196F3"/>
</LinearLayout>
